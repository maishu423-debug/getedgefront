# Copy to .env and fill in. Never commit .env.

APP_ENV=dev                               # dev | test | prod (OpenAPI docs only in dev)
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://edgefront:edgefront@postgres:5432/edgefront
API_INTERNAL_URL=http://api:8000          # web -> api (Railway: http://api.railway.internal:PORT)

CONTACT_EMAIL=                            # used in NWS User-Agent (owner to supply, Q1)

METAR_POLL_SECONDS=180
DSM_POLL_SECONDS=720
CLI_POLL_SECONDS=900
FORECAST_POLL_SECONDS=1800
MODEL_POLL_SECONDS=900
STALE_METAR_MINUTES=90

NEXT_PUBLIC_SITE_URL=https://getedgefront.com

# --- Phase 6 (deploy) ---
DB_SIZE_WARN_BYTES=3221225472             # nightly retention warns above 3 GB (5 GB volume)
WORKER_UPSTREAM_ENABLED=true              # false only in CI's Docker smoke test
INDEXING_ENABLED=false                    # web: true only after the owner's "go live"
CSP_MODE=report-only                      # web: report-only | enforce
HSTS_ENABLED=false                        # web: true once getedgefront.com serves HTTPS
RATE_LIMIT_PER_MINUTE=120                 # web: per-IP limit on /api/*

# backup service only (secrets; the bucket must be private)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=edgefront/

# --- v2 Phase 7 (accounts): web, plus INTERNAL_API_TOKEN on api. Owner steps: infra/auth-setup.md
BETTER_AUTH_SECRET=                       # web: 32+ random bytes; signs sessions and email links
BETTER_AUTH_URL=http://localhost:3000     # web: public origin (prod: https://getedgefront.com)
GOOGLE_CLIENT_ID=                         # web: optional locally; without it Google sign-in is hidden
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=                           # web: unset locally -> emails are printed to the console
EMAIL_FROM=EdgeFront <no-reply@getedgefront.com>
INTERNAL_API_TOKEN=                       # web + api: same value; /api/v1/internal/* refuses without it
AUTH_EXTRA_TRUSTED_ORIGINS=               # web: optional extra origins, comma-separated

# --- v2 Phase 8 (billing, Stripe TEST mode only until Phase 11): web. Owner steps: infra/stripe-setup.md
STRIPE_SECRET_KEY=                        # web: sk_test_… / rk_test_… (live keys refused until Phase 11)
STRIPE_WEBHOOK_SECRET=                    # web: whsec_… (Railway: from the setup script; local: stripe listen)
STRIPE_PRICE_ID=                          # web: price_… (the amount shown is read from Stripe)
STRIPE_PORTAL_CONFIGURATION_ID=           # web: bpc_… (Customer Portal configuration)
STRIPE_MANAGED_PAYMENTS=true              # web: Stripe/Link is the merchant of record and handles tax (owner decision)
STRIPE_TAX_ENABLED=false                  # web: only used if STRIPE_MANAGED_PAYMENTS=false
BILLING_TEST_ALLOWLIST=                   # web: test mode only: emails / @domains allowed to subscribe (empty = nobody)

# --- v2 Phase 9 (5-minute HFMETAR): worker (HF_STALE_MINUTES also on api). Owner steps: infra/ldm/README.md
HF_INGEST_ENABLED=false                   # worker: the hfmetar job runs only when true
LDM_API_BASE_URL=                         # worker: https://ldm.getedgefront.com (https only: the token goes with it)
MADIS_API_TOKEN=                          # worker: bearer token of the owner's madis-api
HF_POLL_SECONDS=60
HF_MAX_FILES_PER_RUN=6                    # newest first; the first-run backfill spreads over a few runs
HF_BACKFILL_HOURS=24
HF_STALE_MINUTES=15                       # worker alert + api "stale" after this long without a new reading
